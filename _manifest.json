{
  "manifest_version": 2,
  "id": "github.42yoru.maimai-sim-trader",
  "version": "0.3.1",
  "name": "麦麦模拟盘",
  "description": "让麦麦用自己的判断自动炒一个东方财富妙想模拟组合：妙想负责账户与深度数据，腾讯快照负责盘中报价，她自己决定买卖什么、多久看一次盘，并按自己的语气在指定群或私聊汇报盈亏。纯插件实现，不改主程序。",
  "author": {
    "name": "42yoru",
    "url": "https://github.com/42yoru"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/42yoru/maimai_sim_trader",
    "homepage": "https://github.com/42yoru/maimai_sim_trader",
    "documentation": "https://github.com/42yoru/maimai_sim_trader/blob/main/README.md",
    "issues": "https://github.com/42yoru/maimai_sim_trader/issues"
  },
  "host_application": {
    "min_version": "1.3.9",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.14.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "chat.get_group_streams",
    "chat.get_private_streams",
    "config.get",
    "llm.generate",
    "send.text"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
