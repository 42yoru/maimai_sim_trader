[plugin]
enabled = true
config_version = "0.5.1"

[mx]
# 东方财富妙想 API Key，mkt_v_ 开头；留空则读环境变量 MX_APIKEY
api_key = ""
base_url = "https://mkapi2.dfcfs.com/finskillshub"
timeout = 20.0

[account]
# 账户显示名，留空则自动读妙想返回的组合名
label = ""
# 限价单让价比例：买入往上让、卖出往下让，0.003 即 0.3%
slippage = 0.003
# 单票市值占总资产上限
max_position_ratio = 0.2
# 买入后至少保留的现金比例
min_cash_reserve_ratio = 0.2
# 单日最多下几笔单
max_trades_per_day = 6

[schedule]
enabled = true
# 交易时段，格式 HH:MM-HH:MM
sessions = ["09:30-11:30", "13:00-15:00"]
# 模型没给下次间隔时的默认值（她每轮都能自己决定下次多久再看）
default_interval_minutes = 30
min_interval_minutes = 10
max_interval_minutes = 240
idle_sleep_seconds = 60
startup_delay_seconds = 20

[model]
# 决策用 planner（结构化输出更稳），播报用 replyer（她平时说话的那个）
decision_task_name = "planner"
decision_model = ""
report_task_name = "replyer"
report_model = ""
temperature = 0.7
max_tokens = 4000
# 播报输出上限（推理模型思考也要占额度）
report_max_tokens = 2000
# 单次模型调用允许等多久（毫秒）。宿主默认 30 秒，思考型模型经常不够
request_timeout_ms = 180000

[notify]
platform = "qq"
# 只认这个账号下的聊天流，留空不限
account_id = ""
# 播报到哪个群，填群号；留空表示不播报到任何群
group_ids = []
group_enabled = true
# 私聊播报（功能已做好，先关着）；启用后填要收播报的用户 ID
private_user_ids = []
private_enabled = false
close_report_enabled = true
close_report_after = "15:00"
[owner]
# 能改动股票池和看盘节奏的用户，格式 platform:user_id，例如 "qq:123456789"
# 留空表示只有查询类命令可用
owners = []
