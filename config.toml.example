[plugin]
enabled = true
config_version = "0.8.1"

[mx]
# 东方财富妙想 API Key，mkt_v_ 开头；留空则读环境变量 MX_APIKEY
api_key = ""
# 必须是 https；不建议指向本机、内网或云元数据地址（Key 会跟着请求发出去）
base_url = "https://mkapi2.dfcfs.com/finskillshub"
timeout = 20.0

[account]
# 账户显示名，留空则自动读妙想返回的组合名
label = ""
# 限价单让价比例：买入往上让、卖出往下让，0.003 即 0.3%
slippage = 0.003
# 单票市值占总资产上限
max_position_ratio = 0.2
# 买入后至少保留的现金比例
min_cash_reserve_ratio = 0.2
# 单日最多下几笔单
max_trades_per_day = 6
# 买入费用率（佣金+过户费），只用于额度与仓位换算，真实扣费在妙想侧
buy_fee_rate = 0.0006
# 卖出费用率（含印花税）
sell_fee_rate = 0.0011
# 券商单笔最低佣金（元）：A 股普遍 5 元，模拟它小单的真实成本才会显形；填 0 关闭
min_commission = 5.0

[risk]
# 决策的大胆程度，三档：
#   steady     = 稳健（默认，和上面的数字一致）
#   aggressive = 激进（单票 1.5 倍、现金底线 0.5 倍、每日笔数 1.6 倍、让价 +0.1%）
#   yolo       = 梭哈（单票 2.0 倍、现金 0.15 倍、笔数 2.0 倍、让价 +0.2%）
# 档位越高，换手越勤、仓位越重；手续费是全额模拟的，所以也就越容易亏钱。
# 想要节目效果就往上调，想看它讲纪律就用 steady。
# 档位只是在上面的数字上乘倍数，代码里还有绝对上限（单票 ≤40%、每日 ≤12 笔）。
# 决策 prompt 里会同时给出这一轮实际剩余的额度（单票余量、仓位余量、还能下几笔）。
# 写错了会直接报错，不会静默退回默认档。
profile = "steady"
# 下面四项留空（注释掉）表示沿用档位预设；填了就覆盖，用来单独微调某一项
# position_multiplier = 1.0   # 单票仓位倍数；1.0 = 完全按 [account] 的原始数字，不被放大
# cash_multiplier = 1.0       # 现金底线倍数；越大越保守
# trades_multiplier = 1.0     # 每日笔数倍数；想少动手就填小
# slippage_delta = 0.0        # 在 [account] slippage 之上再加的让价

[schedule]
enabled = true
# 交易时段，格式 HH:MM-HH:MM
sessions = ["09:30-11:30", "13:00-15:00"]
# 模型没给下次间隔时的默认值（她每轮都能自己决定下次多久再看）
default_interval_minutes = 30
min_interval_minutes = 10
max_interval_minutes = 240
idle_sleep_seconds = 60
startup_delay_seconds = 20
# 同一聊天流两次手动看盘（/股 试跑、sim_trader_review）之间的最小间隔，秒；0 表示不限
manual_cooldown_seconds = 60

[model]
# 决策用 planner（结构化输出更稳），播报用 replyer（她平时说话的那个）
decision_task_name = "planner"
decision_model = ""
report_task_name = "replyer"
report_model = ""
temperature = 0.7
# 输出上限；0 = 跟随宿主任务配置（推荐）。填了就覆盖宿主设置，
# 推理模型（reasoning effort）思考也占额度，给小了正文会空、整轮失败
max_tokens = 0
# 播报输出上限；同样 0 = 跟随宿主任务配置
report_max_tokens = 0
# 单次模型调用允许等多久（毫秒）。宿主默认 30 秒，思考型模型经常不够
request_timeout_ms = 180000

[notify]
platform = "qq"
# 只认这个账号下的聊天流，留空不限
account_id = ""
# 播报到哪个群，填群号；留空表示不播报到任何群
group_ids = []
group_enabled = true
# 私聊播报（功能已做好，先关着）；启用后填要收播报的用户 ID
private_user_ids = []
private_enabled = false
close_report_enabled = true
close_report_after = "15:00"
[owner]
# 能改动股票池和看盘节奏的用户，格式 platform:user_id，例如 "qq:123456789"
# 留空表示只有查询类命令可用
owners = []

[prompt]
# 决策用的 system 提示词模板。必须保留 {header}、{max_position_pct}、{min_cash_pct} 三个占位符，
# {limits_notice} 可选；缺了会在加载时直接报错，不会悄悄换回默认模板。
# 不填就等于用插件内置的那一份（想改语气、加自己的交易纪律时再打开它）。
# system_template = '''{header}
# 你现在在替主人打理一个 A 股模拟盘账户……
# '''
